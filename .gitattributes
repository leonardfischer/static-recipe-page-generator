# Normalise line endings: LF in the repository, regardless of the operating system.
* text=auto eol=lf

# Binary files
*.jpg  binary
*.jpeg binary
*.png  binary
*.webp binary
*.ico  binary

# Keep development files out of "composer create-project --prefer-dist" archives
/tests              export-ignore
/phpunit.xml.dist   export-ignore
/phpstan.neon.dist  export-ignore
/.php-cs-fixer.dist.php export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
