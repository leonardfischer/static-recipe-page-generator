<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% for path, modified in entries %}
    <url>
        <loc>{{ absolute_url(path) }}</loc>
{% if modified %}
        <lastmod>{{ modified|date('Y-m-d') }}</lastmod>
{% endif %}
    </url>
{% endfor %}
</urlset>
