{# Recipe card. Expects: recipe, optional heading_level (default: 3) #}
{% import 'components/format.twig' as format %}
{% set heading_level = heading_level|default(3) %}
<article class="card h-100 shadow-sm recipe-card">
    <img src="{{ url(recipe.imageUrlPath) }}" class="card-img-top" alt="{{ recipe.imageAlt }}"
         width="{{ recipe.image.width }}" height="{{ recipe.image.height }}" loading="lazy" decoding="async">
    <div class="card-body d-flex flex-column">
        <a class="badge text-bg-light border text-decoration-none align-self-start mb-2"
           href="{{ url('/' ~ recipe.categorySlug ~ '/') }}">{{ recipe.meta.category }}</a>
        <h{{ heading_level }} class="h5 card-title">
            <a class="stretched-link text-decoration-none" href="{{ url(recipe.urlPath) }}">{{ recipe.meta.title }}</a>
        </h{{ heading_level }}>
        <p class="card-text text-body-secondary">{{ recipe.meta.description }}</p>
        <p class="card-text small text-body-secondary mt-auto mb-0">
            {{ format.duration(recipe.meta.totalTime) }} · {{ format.difficulty(recipe.meta.difficulty) }}
        </p>
    </div>
</article>
